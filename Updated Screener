<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BuilderScreen — India RERA Intelligence</title>
<link href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,6..144,300;0,6..144,500;1,6..144,300&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@400&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --cream:#f7f4ef;--paper:#fdfcfa;--ink:#1a1814;--ink2:#4a4740;--ink3:#9a9590;
  --rule:#e4e0d8;--rule2:#cdc9c0;
  --green:#1a6b3a;--green-bg:#edf7f1;
  --red:#b52b2b;--red-bg:#fdf1f1;
  --amber:#8a5a00;--amber-bg:#fdf6e8;
  --blue:#1a4a8a;--blue-bg:#eef3fc;
  --accent:#c84b0a;
}
body{background:var(--cream);color:var(--ink);font-family:'DM Sans',sans-serif;font-size:14px;min-height:100vh}
::-webkit-scrollbar{width:4px;height:4px}
::-webkit-scrollbar-track{background:var(--cream)}
::-webkit-scrollbar-thumb{background:var(--rule2);border-radius:2px}

header{background:var(--paper);border-bottom:1.5px solid var(--ink);padding:14px 28px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;position:sticky;top:0;z-index:50}
.logo{font-family:'Literata',serif;font-size:20px;font-weight:500;letter-spacing:-.3px}
.logo em{color:var(--accent);font-style:italic;font-weight:300}
.logo-sub{font-size:11px;color:var(--ink3);font-family:'DM Mono',monospace;letter-spacing:.04em;margin-top:1px}
.header-right{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.hstat{font-size:11px;font-family:'DM Mono',monospace;color:var(--ink3)}
.hstat strong{color:var(--accent)}
.refresh-btn{display:flex;align-items:center;gap:6px;padding:6px 14px;border-radius:20px;border:1.5px solid var(--ink);background:var(--ink);color:var(--paper);font-size:12px;font-family:'DM Mono',monospace;cursor:pointer;transition:all .15s}
.refresh-btn:hover{background:var(--accent);border-color:var(--accent)}
.refresh-btn.spinning svg{animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.sync-pill{display:flex;align-items:center;gap:5px;padding:5px 12px;border-radius:20px;border:1px solid var(--rule2);font-size:11px;font-family:'DM Mono',monospace;color:var(--ink2)}
.sdot{width:6px;height:6px;border-radius:50%;background:var(--amber);flex-shrink:0}
.sdot.live{background:var(--green);animation:blink 2s ease-in-out infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}

.page{display:flex;min-height:calc(100vh - 57px)}
.sidebar{width:244px;flex-shrink:0;background:var(--paper);border-right:1px solid var(--rule2);position:sticky;top:57px;height:calc(100vh - 57px);overflow-y:auto}
.fhdr{padding:12px 16px 10px;border-bottom:1px solid var(--rule);display:flex;align-items:center;justify-content:space-between}
.fhdr-title{font-size:10px;font-family:'DM Mono',monospace;letter-spacing:.1em;color:var(--ink3);text-transform:uppercase}
.reset-btn{font-size:11px;color:var(--accent);background:none;border:none;cursor:pointer;font-family:'DM Sans',sans-serif;text-decoration:underline;text-underline-offset:2px}
.fg{padding:11px 16px;border-bottom:1px solid var(--rule)}
.fl{font-size:10px;font-family:'DM Mono',monospace;letter-spacing:.08em;color:var(--ink3);text-transform:uppercase;margin-bottom:7px}
.fi{width:100%;padding:6px 9px;border:1px solid var(--rule2);border-radius:6px;background:var(--cream);font-family:'DM Sans',sans-serif;font-size:13px;color:var(--ink);outline:none;transition:border-color .15s}
.fi:focus{border-color:var(--ink)}
select.fi{cursor:pointer}
.rw{display:flex;align-items:center;gap:8px}
.rw input[type=range]{flex:1;accent-color:var(--ink);cursor:pointer}
.rv{font-family:'DM Mono',monospace;font-size:12px;color:var(--ink2);min-width:30px;text-align:right}
.ci{display:flex;align-items:center;gap:7px;padding:4px 0;cursor:pointer;font-size:12px;color:var(--ink2)}
.ci input{accent-color:var(--ink);cursor:pointer;width:13px;height:13px;flex-shrink:0}

.main{flex:1;padding:18px 22px;min-width:0}
.rbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid var(--rule);flex-wrap:wrap;gap:8px}
.rcount{font-family:'Literata',serif;font-size:17px;font-weight:300}
.rcount strong{font-weight:500}
.srow{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--ink3)}
.ssel{padding:5px 10px;border:1px solid var(--rule2);border-radius:6px;background:var(--paper);font-family:'DM Sans',sans-serif;font-size:12px;color:var(--ink);cursor:pointer;outline:none}

.af{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:12px}
.afc{display:flex;align-items:center;gap:4px;padding:3px 10px;background:var(--ink);color:var(--paper);border-radius:20px;font-size:11px;font-family:'DM Mono',monospace}
.afc button{background:none;border:none;color:var(--paper);cursor:pointer;font-size:13px;line-height:1;padding:0;margin-left:2px;opacity:.7}
.afc button:hover{opacity:1}

/* BUILDER CARD */
.bc{background:var(--paper);border:1px solid var(--rule2);border-radius:10px;margin-bottom:10px;overflow:hidden;transition:box-shadow .15s}
.bc:hover{box-shadow:0 2px 10px rgba(0,0,0,.06)}
.cs{display:grid;grid-template-columns:2fr 76px 76px 66px 58px 56px 34px;align-items:center;padding:12px 15px;cursor:pointer;gap:8px}
.bn{font-size:14px;font-weight:500;color:var(--ink);margin-bottom:1px}
.bm{font-size:11px;color:var(--ink3);font-family:'DM Mono',monospace}
.ub{display:inline-flex;align-items:center;gap:3px;font-size:10px;font-family:'DM Mono',monospace;padding:1px 5px;border-radius:3px;margin-top:2px}
.ub.fresh{color:var(--green);background:var(--green-bg)}
.ub.old{color:var(--amber);background:var(--amber-bg)}
.ms{text-align:center}
.mv{font-family:'DM Mono',monospace;font-size:13px;color:var(--ink)}
.ml{font-size:10px;color:var(--ink3);margin-top:1px}
.sp{display:inline-flex;align-items:center;justify-content:center;width:40px;height:26px;border-radius:5px;font-family:'DM Mono',monospace;font-size:12px}
.sh{background:var(--green-bg);color:var(--green)}
.sm{background:var(--amber-bg);color:var(--amber)}
.sl{background:var(--red-bg);color:var(--red)}
.eb{width:26px;height:26px;border-radius:5px;border:1px solid var(--rule);background:none;cursor:pointer;color:var(--ink3);font-size:15px;display:flex;align-items:center;justify-content:center;transition:all .12s;flex-shrink:0}
.eb:hover{border-color:var(--ink2);color:var(--ink)}
.eb.open{background:var(--ink);color:var(--paper);border-color:var(--ink)}

/* DETAIL PANEL */
.cd{display:none;border-top:1px solid var(--rule);background:var(--cream)}
.cd.open{display:block}

/* TABS */
.tab-row{display:flex;border-bottom:1px solid var(--rule);padding:0 16px;background:var(--paper)}
.tab-btn{padding:8px 14px;font-size:12px;font-family:'DM Mono',monospace;color:var(--ink3);background:none;border:none;border-bottom:2px solid transparent;cursor:pointer;transition:all .12s;margin-bottom:-1px}
.tab-btn:hover{color:var(--ink2)}
.tab-btn.active{color:var(--ink);border-bottom-color:var(--ink)}
.tab-panel{display:none;padding:14px 16px}
.tab-panel.active{display:block}

/* DETAIL GRID */
.dg{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px}
.db{background:var(--paper);border:1px solid var(--rule);border-radius:7px;padding:10px 12px}
.dbl{font-size:10px;font-family:'DM Mono',monospace;letter-spacing:.07em;color:var(--ink3);text-transform:uppercase;margin-bottom:7px}
.dr{display:flex;justify-content:space-between;align-items:center;padding:4px 0;border-bottom:1px solid var(--rule);font-size:12px}
.dr:last-child{border-bottom:none}
.dk{color:var(--ink2)}
.dv{font-family:'DM Mono',monospace;color:var(--ink);font-size:12px}
.st{font-size:10px;font-family:'DM Mono',monospace;letter-spacing:.08em;color:var(--ink3);text-transform:uppercase;margin-bottom:8px;padding-bottom:5px;border-bottom:1px solid var(--rule)}
.tag{font-size:10px;padding:2px 8px;border-radius:3px;font-family:'DM Mono',monospace;display:inline-block;margin:2px}
.tr{background:var(--red-bg);color:var(--red)}
.ta{background:var(--amber-bg);color:var(--amber)}
.tg{background:var(--green-bg);color:var(--green)}
.tb{background:var(--blue-bg);color:var(--blue)}
.pb{display:flex;align-items:center;gap:7px}
.pbb{flex:1;height:4px;background:var(--rule);border-radius:2px;overflow:hidden}
.pbf{height:100%;border-radius:2px}
.pbv{font-family:'DM Mono',monospace;font-size:11px;color:var(--ink2);min-width:28px;text-align:right}

/* PROJECT TABLE */
.proj-table{width:100%;border-collapse:collapse;font-size:12px}
.proj-table th{padding:6px 10px;text-align:left;font-size:10px;font-family:'DM Mono',monospace;letter-spacing:.07em;color:var(--ink3);text-transform:uppercase;background:var(--paper);border-bottom:1px solid var(--rule);white-space:nowrap}
.proj-table td{padding:8px 10px;border-bottom:1px solid var(--rule);vertical-align:top}
.proj-table tr:last-child td{border-bottom:none}
.proj-table tr:hover td{background:rgba(0,0,0,.015)}
.proj-name{font-weight:500;color:var(--ink);margin-bottom:2px}
.proj-loc{font-size:11px;color:var(--ink3);font-family:'DM Mono',monospace}
.proj-bar{height:3px;background:var(--rule);border-radius:2px;overflow:hidden;margin-top:4px;width:80px}
.proj-bar-fill{height:100%;border-radius:2px}

/* COURT */
.cr{display:flex;align-items:flex-start;gap:8px;padding:7px 0;border-bottom:1px solid var(--rule);font-size:12px}
.cr:last-child{border-bottom:none}
.ct{font-family:'DM Mono',monospace;font-size:10px;padding:2px 5px;border-radius:3px;flex-shrink:0;margin-top:1px}
.ct-hc{background:var(--red-bg);color:var(--red)}
.ct-ncdrc{background:var(--amber-bg);color:var(--amber)}
.ct-rera{background:var(--blue-bg);color:var(--blue)}
.ct-sc{background:#f3f0ff;color:#5b2fa0}
.ci2{flex:1;min-width:0}
.ct2{color:var(--ink);margin-bottom:1px}
.cs2{color:var(--ink3);font-size:11px}
.cst{font-family:'DM Mono',monospace;font-size:10px;padding:2px 5px;border-radius:3px;flex-shrink:0}
.cst-p{background:var(--amber-bg);color:var(--amber)}
.cst-r{background:var(--red-bg);color:var(--red)}
.cst-ok{background:var(--green-bg);color:var(--green)}

/* PAGINATION */
.pag{display:flex;align-items:center;justify-content:center;gap:6px;padding:18px 0}
.pb2{padding:5px 12px;border:1px solid var(--rule2);border-radius:6px;background:var(--paper);font-family:'DM Mono',monospace;font-size:12px;color:var(--ink2);cursor:pointer;transition:all .12s}
.pb2:hover{border-color:var(--ink2);color:var(--ink)}
.pb2.active{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.pb2:disabled{opacity:.35;cursor:not-allowed}
.pi{font-family:'DM Mono',monospace;font-size:11px;color:var(--ink3)}

.no-res{text-align:center;padding:60px 20px;color:var(--ink3)}
.no-res-i{font-family:'Literata',serif;font-size:30px;margin-bottom:10px;font-style:italic;color:var(--rule2)}
.toast{position:fixed;bottom:24px;right:24px;background:var(--ink);color:var(--paper);padding:10px 16px;border-radius:8px;font-size:12px;font-family:'DM Mono',monospace;z-index:999;opacity:0;transform:translateY(8px);transition:all .25s;pointer-events:none}
.toast.show{opacity:1;transform:translateY(0)}
</style>
</head>
