// ═══════════════════════════════════════════════════════════════════════════
// SCREENER ENGINE
// ═══════════════════════════════════════════════════════════════════════════
document.getElementById('total-count').textContent = DB.length;
const PAGE = 20;
let page = 1, filtered = [], openCards = new Set();
window._R = [];

function sc(s){return s>=75?'sh':s>=50?'sm':'sl'}
function bc(p){return p>=70?'var(--green)':p>=45?'var(--amber)':'var(--red)'}
function ps(s){return s==='Completed'?'tg':s==='On track'?'tb':s==='Delayed'?'ta':'tr'}
function uR(id,vid){document.getElementById(vid).textContent=document.getElementById(id).value}
function uRp(id,vid){document.getElementById(vid).textContent=document.getElementById(id).value+'%'}
function uRc(){const v=+document.getElementById('f-cases').value;document.getElementById('cases-v').textContent=v>=350?'Any':v}

function gF(){
  return {
    search:document.getElementById('f-search').value.toLowerCase().trim(),
    state:document.getElementById('f-state').value,
    city:document.getElementById('f-city').value,
    minScore:+document.getElementById('f-score').value,
    minDel:+document.getElementById('f-del').value,
    maxCases:+document.getElementById('f-cases').value,
    rera:document.getElementById('f-rera').value,
    nc:document.getElementById('f-nc').checked,
    nd:document.getElementById('f-nd').checked,
    nn:document.getElementById('f-nn').checked,
    ns:document.getElementById('f-ns').checked,
    np:document.getElementById('f-np').checked,
    minBanks:+document.getElementById('f-banks').value,
    minProj:+document.getElementById('f-proj').value,
    sort:document.getElementById('sort-by').value,
  };
}

function fSort(f){
  let d=DB.filter(b=>{
    const s=f.search;
    if(s&&!b.name.toLowerCase().includes(s)&&!b.city.toLowerCase().includes(s)&&!b.projects.some(p=>p.name.toLowerCase().includes(s)))return false;
    if(f.state&&b.state!==f.state)return false;
    if(f.city&&b.city!==f.city)return false;
    if(b.score<f.minScore)return false;
    if(b.del<f.minDel)return false;
    if(f.maxCases<350&&b.cases>f.maxCases)return false;
    if(f.rera&&b.rera!==f.rera)return false;
    if(f.nc&&b.flags.includes('court-active'))return false;
    if(f.nd&&b.flags.includes('delay-risk'))return false;
    if(f.nn&&b.flags.includes('insolvency'))return false;
    if(f.ns&&b.flags.includes('scam-risk'))return false;
    if(f.np&&b.flags.includes('rera-penalised'))return false;
    if(b.banks<f.minBanks)return false;
    if(b.proj<f.minProj)return false;
    return true;
  });
  const[sk,sd]=f.sort.split('-');
  const km={score:'score',cases:'cases',delivery:'del',projects:'proj',name:'name'};
  const k=km[sk]||'score';
  d.sort((a,b)=>{let av=a[k],bv=b[k];if(typeof av==='string'){av=av.toLowerCase();bv=bv.toLowerCase();}return sd==='asc'?(av>bv?1:-1):(av<bv?1:-1);});
  return d;
}

function chips(f){
  const c=[];
  if(f.search)c.push({l:`"${f.search}"`,r:()=>{document.getElementById('f-search').value='';applyFilters();}});
  if(f.state)c.push({l:f.state,r:()=>{document.getElementById('f-state').value='';applyFilters();}});
  if(f.city)c.push({l:f.city,r:()=>{document.getElementById('f-city').value='';applyFilters();}});
  if(f.minScore>0)c.push({l:`Score ≥ ${f.minScore}`,r:()=>{document.getElementById('f-score').value=0;uR('f-score','score-v');applyFilters();}});
  if(f.minDel>0)c.push({l:`On-time ≥ ${f.minDel}%`,r:()=>{document.getElementById('f-del').value=0;uRp('f-del','del-v');applyFilters();}});
  if(f.maxCases<350)c.push({l:`Cases ≤ ${f.maxCases}`,r:()=>{document.getElementById('f-cases').value=350;uRc();applyFilters();}});
  if(f.rera)c.push({l:`RERA: ${f.rera}`,r:()=>{document.getElementById('f-rera').value='';applyFilters();}});
  if(f.nc)c.push({l:'No court',r:()=>{document.getElementById('f-nc').checked=false;applyFilters();}});
  if(f.nd)c.push({l:'No delay',r:()=>{document.getElementById('f-nd').checked=false;applyFilters();}});
  if(f.nn)c.push({l:'No NCLT',r:()=>{document.getElementById('f-nn').checked=false;applyFilters();}});
  if(f.ns)c.push({l:'No scam',r:()=>{document.getElementById('f-ns').checked=false;applyFilters();}});
  if(f.np)c.push({l:'No penalty',r:()=>{document.getElementById('f-np').checked=false;applyFilters();}});
  if(f.minBanks>0)c.push({l:`Banks ≥ ${f.minBanks}`,r:()=>{document.getElementById('f-banks').value=0;uR('f-banks','banks-v');applyFilters();}});
  if(f.minProj>0)c.push({l:`Projects ≥ ${f.minProj}`,r:()=>{document.getElementById('f-proj').value=0;uR('f-proj','proj-v');applyFilters();}});
  window._R=c.map(x=>x.r);
  document.getElementById('af').innerHTML=c.map((x,i)=>`<div class="afc">${x.l}<button onclick="window._R[${i}]()">×</button></div>`).join('');
}

function flagLabel(f){
  return {'court-active':{l:'Court Active',c:'tr'},'delay-risk':{l:'Delay Risk',c:'ta'},'scam-risk':{l:'Scam Risk',c:'tr'},'insolvency':{l:'NCLT',c:'tr'},'rera-penalised':{l:'RERA Penalised',c:'tr'}}[f];
}

function render(data){
  const start=(page-1)*PAGE, pg=data.slice(start,start+PAGE);
  if(!data.length){document.getElementById('bl').innerHTML='<div class="no-res"><div class="no-res-i">∅</div><div>No builders match your filters.</div></div>';document.getElementById('pg').innerHTML='';return;}

  document.getElementById('bl').innerHTML=pg.map(b=>{
    const isOpen=openCards.has(b.id);
    const flags=b.flags.length?b.flags.map(f=>{const d=flagLabel(f);return d?`<span class="tag ${d.c}">${d.l}</span>`:''}).join(''):`<span class="tag tg">No flags</span>`;

    // Build projects table
    const projRows=b.projects.map(p=>{
      const pCol=p.status==='Completed'?'var(--green)':p.status==='On track'?'var(--blue)':p.status==='Delayed'?'var(--amber)':'var(--red)';
      return `<tr>
        <td><div class="proj-name">${p.name}</div><div class="proj-loc">${p.loc}</div>
          <div class="proj-bar"><div class="proj-bar-fill" style="width:${p.pct}%;background:${pCol}"></div></div>
        </td>
        <td><span class="tag ${ps(p.status)}">${p.status}</span></td>
        <td><span style="font-family:'DM Mono',monospace;font-size:11px;color:var(--ink2)">${p.pct}%</span></td>
        <td><span style="font-family:'DM Mono',monospace;font-size:11px;color:var(--ink2)">${p.units.toLocaleString()}</span></td>
        <td><span style="font-size:11px;color:var(--ink3)">${p.completion}</span></td>
        <td><span style="font-family:'DM Mono',monospace;font-size:10px;color:var(--blue)">${p.rera_id}</span></td>
        <td><span style="font-size:11px;color:var(--ink3)">${p.type}</span></td>
      </tr>`;
    }).join('');

    const courts=b.courts.length?b.courts.map(c=>`<div class="cr"><span class="ct ${c.tc}">${c.type}</span><div class="ci2"><div class="ct2">${c.case}</div><div class="cs2">${c.det}</div></div><span class="cst ${c.sc}">${c.st}</span></div>`).join(''):`<div style="font-size:12px;color:var(--ink3);padding:6px 0">No court records on file</div>`;

    return `<div class="bc" id="card-${b.id}">
      <div class="cs" onclick="toggle(${b.id})">
        <div>
          <div class="bn">${b.name}</div>
          <div class="bm">${b.city} · ${b.state} · Est. ${b.yr} · CIN: ${b.cin}</div>
        </div>
        <div class="ms"><div><span class="sp ${sc(b.score)}">${b.score}</span></div><div class="ml">score</div></div>
        <div class="ms"><div class="mv">${b.del}%</div><div class="ml">on-time</div></div>
        <div class="ms"><div class="mv" style="color:${b.cases>50?'var(--red)':b.cases>10?'var(--amber)':'var(--green)'}">${b.cases}</div><div class="ml">cases</div></div>
        <div class="ms"><div class="mv">${b.proj}</div><div class="ml">projects</div></div>
        <div class="ms"><div class="mv">${b.banks}</div><div class="ml">banks</div></div>
        <button class="eb ${isOpen?'open':''}">${isOpen?'−':'+'}</button>
      </div>

      <div class="cd ${isOpen?'open':''}">
        <div class="tab-row">
          <button class="tab-btn active" onclick="switchTab(${b.id},0,this)">Overview</button>
          <button class="tab-btn" onclick="switchTab(${b.id},1,this)">Ongoing Projects (${b.projects.length})</button>
          <button class="tab-btn" onclick="switchTab(${b.id},2,this)">Court Records (${b.courts.length})</button>
        </div>

        <!-- TAB 0: OVERVIEW -->
        <div class="tab-panel active" id="tab-${b.id}-0">
          <div class="dg">
            <div class="db">
              <div class="dbl">RERA profile</div>
              <div class="dr"><span class="dk">Status</span><span class="dv">${b.rera}</span></div>
              <div class="dr"><span class="dk">Complaints filed</span><span class="dv">${b.comp}</span></div>
              <div class="dr"><span class="dk">Complaints resolved</span>
                <div class="pb" style="width:120px"><div class="pbb"><div class="pbf" style="width:${b.res}%;background:${bc(b.res)}"></div></div><span class="pbv">${b.res}%</span></div>
              </div>
              <div class="dr"><span class="dk">Bank approvals</span><span class="dv">${b.banks} lenders</span></div>
            </div>
            <div class="db">
              <div class="dbl">Corporate health</div>
              <div class="dr"><span class="dk">MCA status</span><span class="dv">${b.mca}</span></div>
              <div class="dr"><span class="dk">CIN number</span><span class="dv" style="font-size:10px">${b.cin}</span></div>
              <div class="dr"><span class="dk">Total projects</span><span class="dv">${b.proj}</span></div>
              <div class="dr"><span class="dk">Buyer sentiment</span><span class="dv">${b.sent}/5.0</span></div>
            </div>
            <div class="db">
              <div class="dbl">Risk flags</div>
              <div style="padding:6px 0">${flags}</div>
            </div>
          </div>
          <div style="font-size:11px;color:var(--ink3);font-family:'DM Mono',monospace;padding:6px 0">
            Sources: RERA portals · eCourts API · MCA21 · NCDRC · Supreme Court · Consumer forums
          </div>
        </div>

        <!-- TAB 1: PROJECTS -->
        <div class="tab-panel" id="tab-${b.id}-1">
          <div style="overflow-x:auto">
            <table class="proj-table">
              <thead><tr>
                <th>Project name &amp; location</th>
                <th>Status</th>
                <th>Built</th>
                <th>Units</th>
                <th>Completion</th>
                <th>RERA ID</th>
                <th>Type</th>
              </tr></thead>
              <tbody>${projRows}</tbody>
            </table>
          </div>
        </div>

        <!-- TAB 2: COURT -->
        <div class="tab-panel" id="tab-${b.id}-2">
          ${courts}
        </div>
      </div>
    </div>`;
  }).join('');

  // Pagination
  const pages=Math.ceil(data.length/PAGE);
  if(pages<=1){document.getElementById('pg').innerHTML='';return;}
  let h=`<button class="pb2" onclick="gP(${page-1})" ${page===1?'disabled':''}>← Prev</button>`;
  for(let i=1;i<=pages;i++){
    if(i===1||i===pages||Math.abs(i-page)<=1)h+=`<button class="pb2 ${i===page?'active':''}" onclick="gP(${i})">${i}</button>`;
    else if(Math.abs(i-page)===2)h+=`<span class="pi">…</span>`;
  }
  h+=`<button class="pb2" onclick="gP(${page+1})" ${page===pages?'disabled':''}>Next →</button>`;
  h+=`<span class="pi">Showing ${Math.min(start+1,data.length)}–${Math.min(start+PAGE,data.length)} of ${data.length}</span>`;
  document.getElementById('pg').innerHTML=h;
}

function gP(p){const pages=Math.ceil(filtered.length/PAGE);if(p<1||p>pages)return;page=p;render(filtered);window.scrollTo({top:0,behavior:'smooth'});}

function toggle(id){
  if(openCards.has(id))openCards.delete(id);else openCards.add(id);
  render(filtered);
}

function switchTab(bid,idx,btn){
  // Deactivate all tabs for this card
  document.querySelectorAll(`#card-${bid} .tab-btn`).forEach(b=>b.classList.remove('active'));
  document.querySelectorAll(`#card-${bid} .tab-panel`).forEach(p=>p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById(`tab-${bid}-${idx}`).classList.add('active');
}

function applyFilters(){
  const f=gF();
  filtered=fSort(f);
  page=1;
  document.getElementById('rc').textContent=filtered.length;
  chips(f);
  render(filtered);
}

function resetAll(){
  document.getElementById('f-search').value='';
  ['f-state','f-city','f-rera'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('f-score').value=0;document.getElementById('score-v').textContent='0';
  document.getElementById('f-del').value=0;document.getElementById('del-v').textContent='0%';
  document.getElementById('f-cases').value=350;document.getElementById('cases-v').textContent='Any';
  document.getElementById('f-banks').value=0;document.getElementById('banks-v').textContent='0';
  document.getElementById('f-proj').value=0;document.getElementById('proj-v').textContent='0';
  ['f-nc','f-nd','f-nn','f-ns','f-np'].forEach(id=>document.getElementById(id).checked=false);
  openCards.clear();
  applyFilters();
}

function doRefresh(){
  const btn=document.getElementById('rfbtn');
  btn.classList.add('spinning');
  document.getElementById('stext').textContent='Refreshing…';
  setTimeout(()=>{
    btn.classList.remove('spinning');
    document.getElementById('stext').textContent='Updated '+new Date().toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'});
    document.getElementById('sdot').className='sdot live';
    const t=document.getElementById('toast');
    t.textContent='Data refreshed — '+DB.length+' builders · '+new Date().toLocaleString('en-IN');
    t.classList.add('show');
    setTimeout(()=>t.classList.remove('show'),3000);
  },1200);
}

applyFilters();
document.getElementById('stext').textContent='Ready — '+DB.length+' builders loaded';
</script>
</body>
</html>
